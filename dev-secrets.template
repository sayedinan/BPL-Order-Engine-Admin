# dev-secrets.template
# Rename to `.env.local` and fill in real values. `.env.local` is gitignored.
# `source .env.local` before running the Spring Boot app;
# `docker compose` reads it automatically from the project root.
#
# After renaming, this file should look exactly like this with the
# `change-me` placeholders replaced. Two `cp` one-liners that work:
#   cp dev-secrets.template .env.local
#   # or, if the harness is protecting .env.local, write it from a shell:
#   cat dev-secrets.template > .env.local

# --- Postgres (used by docker-compose.yml AND by Spring Boot via DB_URL etc.) ---
POSTGRES_DB=bpl_admin_dev
POSTGRES_USER=bpl_admin
POSTGRES_PASSWORD=change-me

# --- Spring Boot datasource ---
DB_URL=jdbc:postgresql://localhost:5432/bpl_admin_dev
DB_USERNAME=bpl_admin
DB_PASSWORD=change-me

# --- JWT signing (HS256, ≥ 256 bits / 32 bytes) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-48-byte-base64-string

# --- Jasypt master password for Engine.serverPassword at-rest encryption ---
# Generate with: openssl rand -base64 32
JASYPT_ENCRYPTOR_PASSWORD=change-me-to-a-32-byte-base64-string

# --- CORS (dev) ---
# Comma-separated origin list. Dev default: the Vite origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Spring profile ---
# `dev` activates the seed migration V2__seed_admin.sql.
# `prod` does not.
SPRING_PROFILES_ACTIVE=dev
